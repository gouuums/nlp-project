            "/usr/local/lib/python3.12/dist-packages/sklearn/manifold/_spectral_embedding.py:329: UserWarning: Graph is not fully connected, spectral embedding may not work as expected.\n",
            "  warnings.warn(\n"
          ]
        }
      ],
      "source": [
        "# We apply the previous method to our corpus\n",
        "\n",
        "df[\"text_cluster\"] = spectral_cluster(text_embeddings, n_clusters=8, features=True)\n",
        "df[\"entities_cluster\"] = spectral_cluster(ner_distance, n_clusters=8, features=False)"
      ]
    },
