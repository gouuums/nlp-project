      "source": [
        "def get_page_content_plaintxt(title):\n",
        "  \"\"\" Request the content of a chosen page from the English Wikipedia API, using the 'extracts' module.\n",
        "  \"\"\"\n",
        "  # Define API endpoint and parameters\n",
        "  base_url = \"https://en.wikipedia.org/w/api.php\"\n",
        "  params = {\n",
        "        'action': 'query',\n",
        "        'prop': 'extracts',       # We ask the API for the content (extract)\n",
        "        'titles': title,\n",
        "        'explaintext': True,      # We convert the HTML format into raw text\n",
        "        'exsectionformat': 'plain',\n",
        "        'format': 'json'\n",
        "    }\n",
        "\n",
        "  try:\n",
        "      # We make the API request\n",
        "      response = requests.get(base_url, headers=headers, params=params)\n",
        "      response.raise_for_status()\n",
        "      data = response.json()\n",
        "\n",
        "      # Then, we extract the page content\n",
        "      # The JSON path is: query -> pages -> [ID] -> extract\n",
        "      pages = data.get('query', {}).get('pages', {})\n",
        "\n",
        "      if pages:\n",
        "          # We retrieve the first key, i.e. the ID of the page\n",
        "          page_id = list(pages.keys())[0]\n",
        "\n",
        "          if page_id == \"-1\": # If a page in not found, the API returns \"-1\",\n",
        "                              # which is useful to identify where errors occured\n",
        "              return \"\"\n",
        "\n",
        "          page_data = pages[page_id]\n",
        "          pages_content = page_data.get('extract', \"\")  # We retrieve the text, and, if it is empty,\n",
        "                                                          # it returns an empty sequence\n",
        "      else:\n",
        "          pages_content = \"\"\n",
        "\n",
        "      return pages_content\n",
        "\n",
        "  except Exception as e:\n",
        "      print(f\"Error occured while retrieving the text for'{title}': {e}\")\n",
        "      return \"\""
      ]
    },
