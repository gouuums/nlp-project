      "source": [
        "# Analysis of text annotations\n",
        "\n",
        "def analyse_text(text):\n",
        "  \"\"\" Analyse the text using the spaCy framework.\n",
        "  \"\"\"\n",
        "  doc = nlp(text)\n",
        "\n",
        "  tokens = [token.text.lower() for token in doc if not token.is_punct and not token.is_space]\n",
        "\n",
        "  num_tokens = len(tokens)\n",
        "\n",
        "  num_sentences = len(list(doc.sents))\n",
        "\n",
        "  if num_tokens == 0 or num_sentences == 0:\n",
        "      return {'n_words': 0, 'n_sentences': 0, 'ttr': 0, 'mean_sent_len': 0}\n",
        "\n",
        "  num_unique_tokens = len(set(tokens)) # We compute the ttr using the formula : unique vocab/total words\n",
        "  ttr = num_unique_tokens / num_tokens\n",
        "\n",
        "  mean_sent_len = num_tokens / num_sentences\n",
        "\n",
        "  return {\n",
        "        'n_words': num_tokens,\n",
        "        'n_sentences': num_sentences,\n",
        "        'ttr': ttr,\n",
        "        'mean_sent_len': mean_sent_len\n",
        "    }\n",
        "\n",
        "df_analysis = df[\"content\"].apply(analyse_text).apply(pd.Series)\n",
        "df = pd.concat([df, df_analysis], axis=1)\n",
        "print(df.head())\n"
      ]
    },
