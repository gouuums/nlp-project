      "outputs": [],
      "source": [
        "# Bonus : heatmap of genre per cluster\n",
        "def plot_genre_cluster_heatmap(df, cluster_col=\"text_cluster\"):\n",
        "    # Expand genres\n",
        "    exploded = df.explode(\"genres\")\n",
        "\n",
        "    # Build contingency table\n",
        "    table = pd.crosstab(exploded[cluster_col], exploded[\"genres\"])\n",
        "\n",
        "    # Normalize row-wise (per cluster)\n",
        "    table_norm = table.div(table.sum(axis=1), axis=0)\n",
        "\n",
        "    plt.figure(figsize=(14,8))\n",
        "    sns.heatmap(table_norm, annot=True, cmap=\"YlGnBu\", fmt=\".2f\")\n",
        "    plt.title(f\"Genre Distribution by Cluster — {cluster_col}\")\n",
        "    plt.xlabel(\"Genre\")\n",
        "    plt.ylabel(\"Cluster\")\n",
        "    plt.xticks(rotation=60)\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n"
      ]
    },
